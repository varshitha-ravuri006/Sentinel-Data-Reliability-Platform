# DAY 5 — Contract API + reporting + quarantine view

**Goal:** define contracts through the API, see a health report, and browse
quarantined rows.

No new installs.

## Person B — rules (contract) CRUD + quarantine endpoint

**File: `app/api/rules.py`** — **Create**.

```python
from fastapi import APIRouter, Depends
from pydantic import BaseModel
from sqlalchemy.orm import Session

from app.core.db import get_db
from app.models.tables import ValidationRule

router = APIRouter(prefix="/rules", tags=["contracts"])


class RuleIn(BaseModel):
    dataset_name: str
    column_name: str
    rule_type: str
    rule_params: dict = {}


@router.post("")
def create_rule(rule: RuleIn, db: Session = Depends(get_db)):
    r = ValidationRule(**rule.model_dump())
    db.add(r); db.commit(); db.refresh(r)
    return {"id": r.id}


@router.get("")
def list_rules(dataset: str, db: Session = Depends(get_db)):
    rows = db.query(ValidationRule).filter(
        ValidationRule.dataset_name == dataset).all()
    return [
        {"id": r.id, "column": r.column_name,
         "rule_type": r.rule_type, "params": r.rule_params}
        for r in rows
    ]


@router.delete("/{rule_id}")
def delete_rule(rule_id: int, db: Session = Depends(get_db)):
    db.query(ValidationRule).filter(ValidationRule.id == rule_id).delete()
    db.commit()
    return {"deleted": rule_id}
```

**File: `app/api/validation.py`** — **Edit**: add the quarantine endpoint to the
existing router.

```python
from app.models.tables import Quarantine


@router.get("/{dataset_id}/quarantine")
def quarantine(dataset_id: int, limit: int = 50, offset: int = 0,
               db: Session = Depends(get_db)):
    rows = (db.query(Quarantine)
            .filter(Quarantine.dataset_id == dataset_id)
            .offset(offset).limit(limit).all())
    return [
        {"row_number": r.row_number, "data": r.data, "reasons": r.failure_reasons}
        for r in rows
    ]
```

## Person A — report endpoint + datasets list + register rules router

**File: `app/api/validation.py`** — **Edit**: add the report endpoint (needs
`Dataset` and `Quarantine` imports at the top).

```python
from app.models.tables import Dataset


@router.get("/{dataset_id}/report")
def report(dataset_id: int, db: Session = Depends(get_db)):
    ds = db.query(Dataset).filter(Dataset.id == dataset_id).first()
    if ds is None:
        raise HTTPException(status_code=404, detail="dataset not found")

    quarantined = db.query(Quarantine).filter(
        Quarantine.dataset_id == dataset_id).all()
    counter: dict = {}
    for q in quarantined:
        for reason in q.failure_reasons:
            key = f"{reason['column']} · {reason['rule_type']}"
            counter[key] = counter.get(key, 0) + 1
    most_common = max(counter, key=counter.get) if counter else None

    return {
        "dataset": ds.name, "total_rows": ds.total_rows,
        "valid": ds.valid_rows, "invalid": ds.invalid_rows,
        "health_score": ds.health_score, "status": ds.status,
        "most_common_error": most_common,
    }
```

