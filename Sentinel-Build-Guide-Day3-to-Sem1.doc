# DAY 4 — All six validation rules

**Goal:** the engine supports all six rule types, each with a test.

No new installs.

## Person A — replace the engine with the full version

The new `validate()` handles `unique` specially, because uniqueness is
**column-global** (it depends on the whole column), unlike the other rules which
are **row-local**. Understand this — it's a great interview point.

**File: `app/services/engine.py`** — **Replace** the whole file with:

```python
"""The validation engine.

Row-local rules are functions (value, params) -> error string | None,
registered in RULES. The 'unique' rule is column-global and handled specially
inside validate().
"""
import re
from datetime import datetime

from app.schemas.contracts import (
    InvalidRow, Rule, RowFailure, ValidationResult,
)


# ---- row-local rule functions ----

def _not_null(value, params):
    if value is None or value == "":
        return "value is required"
    return None


def _positive(value, params):
    try:
        n = float(value)
    except (TypeError, ValueError):
        return "must be a number"
    if n <= 0:
        return "must be greater than 0"
    return None


def _in_set(value, params):
    allowed = params.get("allowed", [])
    if value not in allowed:
        return f"must be one of {allowed}"
    return None


def _valid_date(value, params):
    fmt = params.get("format", "%Y-%m-%d")
    if value is None or value == "":
        return "date is required"
    try:
        datetime.strptime(value, fmt)
    except (TypeError, ValueError):
        return f"must be a valid date ({fmt})"
    return None


def _regex(value, params):
    pattern = params.get("pattern", "")
    if value is None or not re.match(pattern, str(value)):
        return "does not match required pattern"
    return None


# The registry of row-local rules. ('unique' is handled in validate().)
RULES = {
    "not_null": _not_null,
    "positive": _positive,
    "in_set": _in_set,
    "valid_date": _valid_date,
    "regex": _regex,
}


def validate(rows: list[dict], rules: list[Rule]) -> ValidationResult:
    # Pre-compute duplicate values for any 'unique' rules (column-global).
    unique_dupes: dict[str, set] = {}
    for rule in rules:
        if rule.rule_type == "unique":
            seen: dict = {}
            for row in rows:
                v = row.get(rule.column)
                seen[v] = seen.get(v, 0) + 1
            unique_dupes[rule.column] = {v for v, c in seen.items() if c > 1}

    valid_rows: list[dict] = []
    invalid_rows: list[InvalidRow] = []

    for i, row in enumerate(rows):
        reasons: list[RowFailure] = []
        for rule in rules:
            value = row.get(rule.column)
            if rule.rule_type == "unique":
                if value in unique_dupes.get(rule.column, set()):
                    reasons.append(RowFailure(
                        column=rule.column, rule_type="unique",
                        detail="duplicate value",
                    ))
                continue
            check = RULES.get(rule.rule_type)
            if check is None:
                continue
            error = check(value, rule.params)
            if error is not None:
                reasons.append(RowFailure(
                    column=rule.column, rule_type=rule.rule_type, detail=error,
                ))
        if reasons:
            invalid_rows.append(InvalidRow(row_number=i, data=row, reasons=reasons))
        else:
            valid_rows.append(row)

    total = len(rows)
    valid_count = len(valid_rows)
    invalid_count = len(invalid_rows)
    health = round(100 * valid_count / total, 2) if total else 0.0

    return ValidationResult(
        total_rows=total, valid_count=valid_count, invalid_count=invalid_count,
        health_score=health, valid_rows=valid_rows, invalid_rows=invalid_rows,
    )
```

> Note: CSV values arrive as **strings**, which is why `_positive` and
> `_valid_date` convert/parse rather than assuming a number or date.

## Person B — add rule tests

**File: `app/tests/test_rules.py`** — **Create**. (You own the tests for the
simpler rules; Person A owns tests for date/unique/regex — put them here together.)

```python
from app.schemas.contracts import Rule
from app.services.engine import validate


def _run(rows, rules):
    return validate(rows, rules)


def test_positive():
    rows = [{"amount": "5"}, {"amount": "-3"}, {"amount": "0"}, {"amount": "x"}]
    r = _run(rows, [Rule(column="amount", rule_type="positive")])
    assert r.valid_count == 1        # only "5"
    assert r.invalid_count == 3


def test_in_set():
    rows = [{"status": "paid"}, {"status": "unknown"}]
    rule = Rule(column="status", rule_type="in_set",
                params={"allowed": ["pending", "paid", "shipped", "cancelled"]})
    r = _run(rows, [rule])
    assert r.valid_count == 1
    assert r.invalid_count == 1


def test_valid_date():
    rows = [{"d": "2024-01-15"}, {"d": "not-a-date"}, {"d": ""}]
    r = _run(rows, [Rule(column="d", rule_type="valid_date")])
    assert r.valid_count == 1
    assert r.invalid_count == 2


def test_regex_email():
    rows = [{"email": "a@b.com"}, {"email": "nope"}]
    rule = Rule(column="email", rule_type="regex",
                params={"pattern": r"[^@]+@[^@]+\.[^@]+"})
    r = _run(rows, [rule])
    assert r.valid_count == 1


def test_unique():
    rows = [{"id": "1"}, {"id": "2"}, {"id": "1"}]  # "1" duplicated
    r = _run(rows, [Rule(column="id", rule_type="unique")])
    assert r.invalid_count == 2       # both rows with id "1"
    assert r.valid_count == 1
```

