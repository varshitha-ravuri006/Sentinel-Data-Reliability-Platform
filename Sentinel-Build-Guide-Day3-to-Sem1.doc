# DAY 6 — Robustness & end-to-end integration

**Goal:** handle errors gracefully and prove the full flow with an automated test.

No new installs.

## Person A — end-to-end integration test

**File: `app/tests/test_end_to_end.py`** — **Create**.

```python
import io
from fastapi.testclient import TestClient
from app.main import app
from app.core.db import SessionLocal
from app.models.tables import (
    Dataset, ValidationRule, RawRecord, ValidRecord, Quarantine,
)

client = TestClient(app)


def test_full_pipeline():
    name = "e2e_orders"
    csv_data = (
        "order_id,customer_id,amount,status\n"
        "1,C1,10,paid\n"
        "2,,20,paid\n"          # bad: missing customer_id
        "3,C3,-5,paid\n"        # bad: negative amount
        "4,C4,40,unknown\n"     # bad: status not in set
        "5,C5,50,shipped\n"
    )
    files = {"file": ("o.csv", io.BytesIO(csv_data.encode()), "text/csv")}
    up = client.post(f"/datasets/upload?name={name}", files=files)
    dsid = up.json()["dataset_id"]

    for col, rt, params in [
        ("customer_id", "not_null", {}),
        ("amount", "positive", {}),
        ("status", "in_set", {"allowed": ["pending", "paid", "shipped", "cancelled"]}),
    ]:
        client.post("/rules", json={
            "dataset_name": name, "column_name": col,
            "rule_type": rt, "rule_params": params,
        })

    client.post(f"/datasets/{dsid}/validate")
    report = client.get(f"/datasets/{dsid}/report").json()
    assert report["total_rows"] == 5
    assert report["valid"] == 2
    assert report["invalid"] == 3

    # cleanup
    db = SessionLocal()
    try:
        db.query(RawRecord).filter(RawRecord.dataset_id == dsid).delete()
        db.query(ValidRecord).filter(ValidRecord.dataset_id == dsid).delete()
        db.query(Quarantine).filter(Quarantine.dataset_id == dsid).delete()
        db.query(ValidationRule).filter(ValidationRule.dataset_name == name).delete()
        db.query(Dataset).filter(Dataset.id == dsid).delete()
        db.commit()
    finally:
        db.close()
```

## Person B — input validation & error handling

**File: `app/api/upload.py`** — **Edit**: guard against non-CSV and empty files.

```python
from fastapi import HTTPException
```
Replace the body of `upload_dataset` up to creating rows with:
```python
    if not file.filename.lower().endswith(".csv"):
        raise HTTPException(status_code=400, detail="Only .csv files are supported")
    content = await file.read()
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError:
        raise HTTPException(status_code=400, detail="File must be UTF-8 text")
    rows = list(csv.DictReader(io.StringIO(text)))
    if not rows:
        raise HTTPException(status_code=400, detail="CSV has no data rows")
```

**File: `scripts/seed_demo.py`** — **Create** (a helper to load a demo dataset +
contract for the review). Run it from inside the container.

```python
"""Seed a demo 'orders' dataset with a contract, for the demo."""
import csv, io
from app.core.db import SessionLocal
from app.models.tables import Dataset, RawRecord, ValidationRule

CSV = (
    "order_id,customer_id,amount,status\n"
    "1,C1,10,paid\n2,,20,paid\n3,C3,-5,paid\n4,C4,40,unknown\n5,C5,50,shipped\n"
)

def main():
    db = SessionLocal()
    rows = list(csv.DictReader(io.StringIO(CSV)))
    ds = Dataset(name="demo_orders", source_filename="demo.csv",
                 total_rows=len(rows), status="uploaded")
    db.add(ds); db.commit(); db.refresh(ds)
    for i, r in enumerate(rows):
        db.add(RawRecord(dataset_id=ds.id, row_number=i, data=dict(r)))
    for col, rt, p in [("customer_id","not_null",{}),("amount","positive",{}),
                       ("status","in_set",{"allowed":["pending","paid","shipped","cancelled"]})]:
        db.add(ValidationRule(dataset_name="demo_orders", column_name=col,
                              rule_type=rt, rule_params=p))
    db.commit(); db.close()
    print(f"Seeded demo_orders with id {ds.id}")

if __name__ == "__main__":
    main()
```

## Day 6 — Run & Checkpoint

```powershell
docker compose up -d --build
docker compose exec app pytest -q
docker compose exec app python -m scripts.seed_demo
```

**Checkpoint:** end-to-end test passes; bad files are rejected with clear errors;
a demo dataset can be seeded on demand.

**Commit:** push, review, merge.

